# ============================================================================
# 🌌 Universal Full-Stack Evo-OS · Environment Configuration Template
# ============================================================================

# 1. Task Completion & Approval Alert Email (used by EVO-024 sendmail hook)
EVO_NOTIFY_EMAIL=your-email@example.com

# 2. Default Workspace Container Root
EVO_WORKSPACE_ROOT=/Users/yourname/workspace

# 3. Feishu Mobile Commander Bridge (@larksuiteoapi/node-sdk WSClient - No Public IP Required)
FEISHU_APP_ID=cli_your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
COMMANDER_CONVERSATION_ID=your_commander_cascade_uuid
FEISHU_BRIDGE_PORT=18910
EVO_BRIDGE_ROOT=/Users/yourname/workspace/your-project
EVO_ENV_FILE=/Users/yourname/workspace/your-project/.env

# 4. Antigravity LanguageServer Auto-Discovery Overrides (Optional - Auto-discovered by default)
ANTIGRAVITY_LS_ADDRESS=127.0.0.1:50000
ANTIGRAVITY_CSRF_TOKEN=optional_csrf_token_override
ANTIGRAVITY_SIDECAR_WEB_PORT=18920
